# ============================================================
# Berlo Communications — Monorepo .gitignore
# ============================================================

# --- Backend (Laravel) ---
backend/.env
backend/vendor/
backend/storage/logs/*.log
backend/storage/app/public
backend/public/storage
backend/bootstrap/cache/*.php
backend/node_modules/
backend/.phpunit.cache/

# --- Frontend (React / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# --- OS & Editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json
*.code-workspace

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Misc ---
.cache/
tmp/

# --- Scratch & Temporary Development Directories ---
scratch/
**/scratch/
.scratch/
**/.scratch/

# --- Agent & Workspace Internal Tools ---
.agents/
**/.agents/
.tools/
**/.tools/
.gemini/
**/.gemini/

# --- Testing & MCP Output ---
.playwright-mcp/
**/.playwright-mcp/
__pycache__/
*.pyc
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.html



